{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-extraneous-class": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "coverage/**",
    "reports/**"
  ]
}
